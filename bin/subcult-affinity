#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/subcult-rice"
theme_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme"
mode_file="$state_dir/affinity-mode"
manual_file="$state_dir/affinity-manual"
active_file="$state_dir/affinity-active"
background_link="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/background"
variant_cli="$(cd -- "$(dirname -- "$0")" && pwd)/subcult-theme-variant"
tmux_theme=${SUBCULT_TMUX_THEME:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux/themes/subcult.tmux.conf}
mkdir -p "$state_dir"

motion_mode() {
  subcult-motion status --json 2>/dev/null | jq -r '.mode // "full"' 2>/dev/null || echo full
}

detect() {
  case "${1##*/}" in
    5-subcult-acid.*) echo acid ;;
    6-subcult-paper.*) echo paper ;;
    2-subcult-violet.*) echo violet ;;
    7-subcult-ink.*) echo ink ;;
    *) echo neutral ;;
  esac
}

load_profile() {
  local payload key value
  payload=$("$variant_cli" resolve "$1") || exit $?
  while IFS=$'\t' read -r key value; do printf -v "$key" '%s' "$value"; done < <(
    jq -r 'to_entries[] | select(.key | IN("label","terminal","mode","accent","accent2","selection","muted","background","dark","darker","lighter","foreground","dim","bar_icon","active","variant","variant_label")) | [(if .key == "mode" then "color_mode" else .key end),.value] | @tsv' <<<"$payload"
  )
}

write_colors() {
  cat > "$1/colors.toml" <<EOF
mode = "$color_mode"
accent = "#$accent"
selection = "#$selection"
muted = "#$muted"
background = "#$background"
dark_background = "#$dark"
darker_background = "#$darker"
lighter_background = "#$lighter"
foreground = "#$foreground"
dark_foreground = "#$dim"
light_foreground = "#$foreground"
bright_foreground = "#FFFFFF"
hyprland_active_border = "rgba(${accent2}ee) rgba(${accent}ee) 45deg"
hyprland_inactive_border = "rgba(${muted}aa)"
active_border_color = "#$accent"
active_tab_background = "#$selection"
red = "#D52032"
yellow = "#F6D447"
orange = "#F28C28"
green = "#00D474"
cyan = "#4FD6C8"
blue = "#5577CC"
magenta = "#A78BFA"
brown = "#8C5B43"
bright_red = "#FF4055"
bright_yellow = "#FFE36A"
bright_green = "#5CFFAE"
bright_cyan = "#75F2E4"
bright_blue = "#7799FF"
bright_magenta = "#C4B5FD"
EOF
}

write_shell() {
  cat > "$1/shell.toml" <<EOF
[bar]
background = "#$dark"
background-alpha = 0.82
text = "#$bar_icon"
active = "#$active"
scale-with-font = true
size-horizontal = 30
size-vertical = 30
[hyprland]
active-border = "rgba(${accent2}ee) rgba(${accent}ee) 45deg"
active-border-foreground = "rgba(${accent2}ee) rgba(${accent}ee) 45deg"
[controls]
normal-color = "#$foreground"
normal-fill-alpha = 0.03
normal-border = "#$muted"
normal-border-width = 1
normal-border-alpha = 0.55
hover-cursor-color = "#$accent"
hover-cursor-fill-alpha = 0.10
hover-cursor-border = "#$accent"
hover-cursor-border-width = 1
hover-cursor-border-alpha = 0.75
focus-color = "#$accent"
focus-fill-alpha = 0.12
focus-border = "#$accent"
focus-border-width = 1
focus-border-alpha = 1.0
selected-color = "#$accent"
selected-fill-alpha = 0.18
selected-border = "#$accent2"
selected-border-width = 1
selected-border-alpha = 1.0
pressed-fill-alpha = 0.25
selection-fill-alpha = 0.38
[spacing]
scale = 0.92
scale-with-font = true
panel-gap = 12
panel-padding = 16
popup-padding = 12
control-gap = 7
row-padding-x = 11
[font]
base-size = 11
caption = 9
heading = 15
display = 23
[popups]
background = "#$dark"
background-alpha = 0.94
text = "#$foreground"
border = "rgba(${accent2}ee) rgba(${accent}ee) 45deg"
border-alpha = 1.0
border-width = 2
[tooltip]
background = "#$background"
background-alpha = 0.97
text = "#$foreground"
border = "#$accent"
border-alpha = 1.0
[notifications]
background = "#$dark"
background-alpha = 0.94
text = "#$foreground"
border = "rgba(${accent2}ee) rgba(${accent}ee) 45deg"
border-alpha = 1.0
border-width = 2
countdown = "#$accent"
[launcher]
background = "#$dark"
background-alpha = 0.93
text = "#$foreground"
border = "rgba(${accent2}ee) rgba(${accent}ee) 45deg"
border-alpha = 1.0
scrim = "#$darker"
scrim-alpha = 0.62
selected-background = "#$selection"
selected-background-alpha = 0.48
selected-text = "#$accent"
selected-border = "#$accent"
selected-border-alpha = 0.9
[menu]
background = "#$dark"
background-alpha = 0.95
text = "#$foreground"
border = "rgba(${accent2}ee) rgba(${accent}ee) 45deg"
border-alpha = 1.0
scrim = "#$darker"
scrim-alpha = 0.62
selected-background = "#$selection"
selected-background-alpha = 0.48
selected-text = "#$accent"
selected-border = "#$accent"
selected-border-alpha = 0.9
[polkit]
background = "#$background"
background-alpha = 1.0
text = "#$foreground"
text-error = "#FF4055"
border = "#$accent"
border-error = "#FF4055"
border-alpha = 1.0
scrim = "#$background"
scrim-alpha = 0.5
accent = "#$accent"
[lock]
background = "#$dark"
background-alpha = 0.88
text = "#$foreground"
placeholder = "#$dim"
text-error = "#FF4055"
border = "#$accent2"
border-active = "rgba(${accent2}ee) rgba(${accent}ee) 45deg"
