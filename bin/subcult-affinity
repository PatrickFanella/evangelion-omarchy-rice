border-alpha = 1.0
selection = "#$accent"
selection-alpha = 0.50
[image-picker]
scrim = "#$background"
scrim-alpha = 0.5
text = "#$foreground"
selected-border = "#$accent"
selected-border-alpha = 1.0
unselected-border = "#$foreground"
unselected-border-alpha = 0.28
EOF
}

write_tmux() {
  cat > "$1/subcult.tmux.conf" <<EOF
# Subcult tmux theme fragment
# Generated by subcult-affinity from the active ${label} palette (${variant_label}).
# Do not edit; affinity and theme-variant changes rewrite this file.

set -g status-left-length 80
set -g status-right-length 120
set -g window-status-separator " "
set -g status-style "bg=default,fg=#$foreground"
set -g status-left "#[fg=#$accent,bg=#$lighter,bold] ◉ #[fg=#$lighter,bg=#$accent]#[fg=#$dark,bg=#$accent,bold] #S #[fg=#$accent,bg=#$accent2]#[fg=#$dark,bg=#$accent2,bold] #h #[fg=#$accent2,bg=default]"
set -g status-right "#[fg=#$lighter,bg=default]#[fg=#$foreground,bg=#$lighter,bold]#{?pane_in_mode, COPY ,}#{?client_prefix, PREFIX ,}#{?window_zoomed_flag, ZOOM ,}#[fg=#$accent2,bg=#$lighter]#[fg=#$dark,bg=#$accent2,bold] %H:%M "
set -g window-status-format "#[fg=#$dim,bg=#$lighter] #I:#W #[fg=#$lighter,bg=default]"
set -g window-status-current-format "#[fg=#$dark,bg=#$accent]#[fg=#$dark,bg=#$accent,bold] #I:#W #[fg=#$accent,bg=default,nobold]"
set -g pane-border-style "fg=#$muted"
set -g pane-active-border-style "fg=#$accent"
set -g message-style "bg=#$dark,fg=#$accent"
set -g message-command-style "bg=#$dark,fg=#$accent2"
set -g mode-style "bg=#$accent,fg=#$dark"
setw -g clock-mode-colour "#$accent"
EOF
}

# tmux follows the palette on a best-effort basis: a missing tmux, an
# unwritable target, or a failed reload never rolls back the affinity.
apply_tmux() {
  command -v tmux >/dev/null 2>&1 || [[ -d ${tmux_theme%/*} ]] || return 0
  mkdir -p "${tmux_theme%/*}" && install -m 0644 "$1/subcult.tmux.conf" "$tmux_theme" || return 0
  [[ ${SUBCULT_SKIP_ACTIVATE:-0} == 1 ]] && return 0
  if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
    tmux source-file -- "$tmux_theme" >/dev/null 2>&1 || true
  fi
}

apply_profile() {
  local profile=$1 tmp backup previous_profile previous_terminal refresh_state=synchronized
  load_profile "$profile"
  previous_profile=$(cat "$active_file" 2>/dev/null || echo neutral)
  previous_terminal=$(subcult-terminal-profile status 2>/dev/null || echo subcult)
  tmp=$(mktemp -d "$state_dir/affinity.XXXXXX")
  backup=$(mktemp -d "$state_dir/affinity-backup.XXXXXX")
  trap 'rm -rf "$tmp" "$backup"' RETURN
  for file in colors.toml shell.toml; do [[ -f "$theme_dir/$file" ]] && cp "$theme_dir/$file" "$backup/$file"; done
  write_colors "$tmp"
  write_shell "$tmp"
  write_tmux "$tmp"
  selection_text=FFFFFF; [[ $color_mode == light ]] && selection_text=$foreground
  if ! install -m 0644 "$tmp/colors.toml" "$theme_dir/colors.toml" || ! install -m 0644 "$tmp/shell.toml" "$theme_dir/shell.toml" || ! SUBCULT_TERMINAL_PROFILE_QUIET=1 SUBCULT_TERMINAL_BACKGROUND="$background" SUBCULT_TERMINAL_FOREGROUND="$foreground" SUBCULT_TERMINAL_MUTED="$muted" SUBCULT_TERMINAL_SELECTION="$selection" SUBCULT_TERMINAL_SELECTION_TEXT="$selection_text" SUBCULT_TERMINAL_ACCENT="$accent" subcult-terminal-profile "$terminal" --no-reload || ! apply_hypr; then
    for file in colors.toml shell.toml; do [[ -f "$backup/$file" ]] && install -m 0644 "$backup/$file" "$theme_dir/$file"; done
    SUBCULT_TERMINAL_PROFILE_QUIET=1 subcult-terminal-profile "$previous_terminal" --no-reload >/dev/null 2>&1 || true
    echo "$previous_profile" > "$active_file"
    echo 'Affinity apply failed; previous state restored.' >&2
    return 1
  fi
  printf '%s\n' "$profile" > "$tmp/active"
  mv -f "$tmp/active" "$active_file"
  apply_tmux "$tmp"
  if ! subcult-bar-refresh --quiet --source affinity; then
    refresh_state=stale
    echo 'Affinity committed, but the live bar did not refresh. Run subcult-bar-refresh; if needed, run omarchy restart shell.' >&2
  fi
  coordinate_wallpaper "$profile" "$previous_profile" "$refresh_state"
  if [[ -z ${SUBCULT_SCENE_TRANSACTION:-} ]] && command -v subcult-scene >/dev/null 2>&1; then
    subcult-scene sync --from-affinity "$profile" >/dev/null 2>&1 || true
  fi
  printf 'Affinity: %s (%s mode)\n' "$label" "$(cat "$mode_file" 2>/dev/null || echo auto)"
}

coordinate_wallpaper() {
  local profile=$1 previous=$2 refresh_state=${3:-synchronized} wallpaper motion affinity_mode message
  wallpaper=$(readlink -f "$background_link" 2>/dev/null || true)
  motion=$(motion_mode)
  affinity_mode=$(cat "$mode_file" 2>/dev/null || echo auto)
  # Omarchy owns preloading and aspect-correct rendering on every output.
  # Off snaps its already selected frame; supported reveal modes stay native.
  if [[ -n $wallpaper && $motion == off ]]; then
    omarchy-shell -q background setInstant "$wallpaper" >/dev/null 2>&1 || true
  fi
  if [[ $profile != "$previous" && $affinity_mode == auto ]]; then
    message="Wallpaper, shell, borders, and new terminals synchronized"
    [[ $refresh_state == synchronized ]] || message="Affinity changed; bar refresh needed — run subcult-bar-refresh"
    omarchy-notification-send -u low -g '󰏘' "SUBCULT AFFINITY // ${label}" \
      "$message" 2>/dev/null || true
  fi
}

apply_hypr() {
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1; then
    hyprctl eval "hl.config({ [\"general.col.active_border\"] = { colors = { \"rgba(${accent2}ee)\", \"rgba(${accent}ee)\" }, angle = 45 }, [\"general.col.inactive_border\"] = \"rgba(${muted}aa)\" })" >/dev/null
  fi
}

command=${1:-status}
case "$command" in
  detect) detect "${2:-}" ;;
  palette)
    profile=${2:-$(cat "$active_file" 2>/dev/null || detect "$(readlink -f "$background_link" 2>/dev/null || true)")}
    load_profile "$profile"
    printf '{"profile":"%s","label":"%s","variant":"%s","variant_label":"%s","mode":"%s","bar_icon":"#%s","background":"#%s","accent":"#%s","active":"#%s"}\n' "$profile" "$label" "$variant" "$variant_label" "$color_mode" "$bar_icon" "$dark" "$accent" "$active"
    ;;
  status)
    mode=$(cat "$mode_file" 2>/dev/null || echo auto)
    affinity=$(cat "$active_file" 2>/dev/null || detect "$(readlink -f "$background_link" 2>/dev/null || true)")
    load_profile "$affinity"
    printf 'mode=%s\nactive=%s\nvariant=%s\nbar_icon=#%s\nbackground=%s\n' "$mode" "$affinity" "$variant" "$bar_icon" "$(readlink -f "$background_link" 2>/dev/null || echo unknown)"
    ;;
  list) printf '%s\n' neutral acid paper violet ink ;;
  auto|reset)
    old_mode=$(cat "$mode_file" 2>/dev/null || echo auto)
    old_manual=$(cat "$manual_file" 2>/dev/null || true)
    echo auto > "$mode_file"
    rm -f "$manual_file"
    if ! apply_profile "$(detect "$(readlink -f "$background_link" 2>/dev/null || true)")"; then
      echo "$old_mode" > "$mode_file"
      [[ -n $old_manual ]] && echo "$old_manual" > "$manual_file"
      exit 1
    fi
    ;;
  set)
    profile=${2:-}
    load_profile "$profile"
    old_mode=$(cat "$mode_file" 2>/dev/null || echo auto)
    old_manual=$(cat "$manual_file" 2>/dev/null || true)
    echo manual > "$mode_file"
    echo "$profile" > "$manual_file"
    if ! apply_profile "$profile"; then
      echo "$old_mode" > "$mode_file"
      if [[ -n $old_manual ]]; then echo "$old_manual" > "$manual_file"; else rm -f "$manual_file"; fi
      exit 1
    fi
    ;;
  apply)
    # Serialize path-unit bursts and debounce the atomic symlink replacement so
    # rapid cycling settles directly on the final wallpaper/profile pair.
    exec 9>"$state_dir/affinity.lock"
    flock 9
    mode=$(cat "$mode_file" 2>/dev/null || echo auto)
    [[ $mode == manual || -n ${2:-} ]] || sleep 0.12
    if [[ $mode == manual && -r $manual_file ]]; then profile=$(cat "$manual_file")
    else profile=$(detect "${2:-$(readlink -f "$background_link" 2>/dev/null || true)}"); fi
    apply_profile "$profile"
    ;;
  *) echo 'Usage: subcult-affinity {status|palette [PROFILE]|list|detect BACKGROUND|auto|reset|set PROFILE|apply [BACKGROUND]}' >&2; exit 2 ;;
esac
