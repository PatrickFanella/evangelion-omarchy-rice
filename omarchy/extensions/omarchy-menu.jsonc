{
  // SUBCULT command interface. Dotted IDs become children of the `subcult` root;
  // targets reuse Omarchy's live providers instead of duplicating their logic.
  "subcult": {
    "icon": "󰢮",
    "label": "SUBCULT Command Interface",
    "title": "SUBCULT // COMMAND",
    "aliases": ["subcult", "subcult", "subcult"],
    "description": "Applications, system control, backgrounds, and presentation mode"
  },
  "subcult.command-palette": {
    "icon": "󰘳",
    "label": "Global Command Palette",
    "action": "omarchy-shell subcult-command-palette open",
    "description": "Fuzzy-search safe actions, settings, workspaces, diagnostics, help, and confirmed system actions"
  },
  "subcult.apps": {
    "icon": "󰀻",
    "label": "Application Index",
    "action": "omarchy-menu summon apps",
    "description": "Search and launch installed applications"
  },
  "subcult.settings": {
    "icon": "󰒓",
    "label": "SUBCULT Control Center",
    "action": "omarchy-shell subcult-settings toggle",
    "description": "Preview, apply, and undo suite settings from one control surface"
  },
  "subcult.workspace-names": {
    "icon": "󰘔",
    "label": "Workspace Identities",
    "action": "omarchy-shell workspace-names toggle",
    "description": "Edit full workspace names and collision-safe compact bar labels"
  },
  "subcult.topology": {
    "icon": "󰍹",
    "label": "Display Topologies",
    "title": "SUBCULT // DISPLAY TOPOLOGY",
    "description": "Inspect, enable, and safely undo saved monitor arrangements"
  },
  "subcult.topology.status": {
    "icon": "󰋼",
    "label": "Topology Status",
    "action": "omarchy-launch-terminal -- bash -lc 'subcult-topology status | jq; echo; read -rp \"Press Enter to close...\"'"
  },
  "subcult.topology.enable": {
    "icon": "󰐊",
    "label": "Enable Hot-Plug Restore",
    "action": "subcult-topology enable",
    "checked": "subcult-topology status | jq -e '.enabled == true' >/dev/null"
  },
  "subcult.topology.disable": {
    "icon": "󰅖",
    "label": "Disable Hot-Plug Restore",
    "action": "subcult-topology disable",
    "checked": "subcult-topology status | jq -e '.enabled == false' >/dev/null"
  },
  "subcult.topology.undo": {
    "icon": "󰕌",
    "label": "Undo Last Topology Apply",
    "action": "subcult-topology undo",
    "description": "Restore the previous monitor, workspace, window, bar, and presentation arrangement"
  },
  "subcult.machine-profile": {
    "icon": "󰆓",
    "label": "Portable Machine Profiles",
    "action": "omarchy-launch-terminal -- bash -lc 'subcult-machine-profile --help; echo; read -rp \"Press Enter to close...\"'",
    "description": "Export or transactionally import privacy-sanitized cross-machine preferences"
  },
  "subcult.scenes": {
    "icon": "󰏘",
    "label": "Affinity Scenes",
    "action": "omarchy-shell scene-editor toggle",
    "description": "Preview and coordinate wallpaper, palette, terminal, and optional scene behavior"
  },
  "subcult.background": {
    "icon": "󰸉",
    "label": "Visual Environment",
    "action": "background=$(omarchy-theme-bg-switcher); [[ -n $background ]] && omarchy-theme-bg-set \"$background\"",
    "description": "Select an SUBCULT wallpaper"
  },
  "subcult.affinity": {
    "icon": "󰏘",
    "label": "Field Affinity",
    "title": "SUBCULT // FIELD AFFINITY",
    "description": "Automatic wallpaper colors or a persistent manual override"
  },
  "subcult.affinity.auto": {
    "icon": "󰑐",
    "label": "Automatic",
    "action": "subcult-affinity auto",
    "checked": "[[ $(subcult-affinity status | sed -n 's/^mode=//p') == auto ]]"
  },
  "subcult.affinity.neutral": {
    "label": "Press",
    "action": "subcult-affinity set neutral"
  },
  "subcult.affinity.acid": {
    "label": "Acid Block",
    "action": "subcult-affinity set acid"
  },
  "subcult.affinity.paper": {
    "label": "Paper Stock",
    "action": "subcult-affinity set paper"
  },
  "subcult.affinity.violet": {
    "label": "Violet Field",
    "action": "subcult-affinity set violet"
  },
  "subcult.affinity.ink": {
    "label": "Ink Run",
    "action": "subcult-affinity set ink"
  },
  "subcult.affinity.refresh-bar": {
    "icon": "󰑐",
    "label": "Refresh SUBCULT Bar",
    "action": "subcult-bar-refresh --notify",
    "description": "Reapply the active affinity palette without restarting the shell"
  },
  "subcult.motion": {
    "icon": "󰔎",
    "label": "Interface Motion",
    "title": "SUBCULT // MOTION CONTROL",
    "description": "Global animation level for participating SUBCULT surfaces"
  },
  "subcult.motion.full": {
    "icon": "󰐊",
    "label": "Full Motion",
    "action": "subcult-motion set full",
    "checked": "[[ $(subcult-motion status) == full ]]",
    "description": "Current v1.1 feel and complete v1.2 motion language"
  },
  "subcult.motion.reduced": {
    "icon": "󰘖",
    "label": "Reduced Motion",
    "action": "subcult-motion set reduced",
    "checked": "[[ $(subcult-motion status) == reduced ]]",
    "description": "Short fades, minimal travel, no blur or repeated movement"
  },
  "subcult.motion.off": {
    "icon": "󰅖",
    "label": "Motion Off",
    "action": "subcult-motion set off",
    "checked": "[[ $(subcult-motion status) == off ]]",
    "description": "Immediate state changes without decorative animation"
  },
  "subcult.presentation": {
    "icon": "󰍹",
    "label": "Presentation Mode",
    "action": "subcult-presentation",
    "checked": "pgrep -f -- '--class=org.omarchy.subcult.' >/dev/null",
    "description": "Toggle system status and resource telemetry"
  },
  "subcult.demo": {
    "icon": "󰙨",
    "label": "Demonstration Mode",
    "title": "SUBCULT // SAFE DEMONSTRATION",
    "description": "Isolated fictional interface scenarios with no live-data mixing"
  },
  "subcult.demo.enter": {"icon":"󰐊","label":"Enter / Resume Demo","action":"subcult-demo enter","checked":"subcult-demo status | grep -qx 'active=yes'"},
  "subcult.demo.next": {"icon":"󰒭","label":"Next Scenario","action":"subcult-demo next","when":"subcult-demo status | grep -qx 'active=yes'"},
  "subcult.demo.previous": {"icon":"󰒮","label":"Previous Scenario","action":"subcult-demo previous","when":"subcult-demo status | grep -qx 'active=yes'"},
  "subcult.demo.capture": {"icon":"󰹑","label":"Metadata-Safe Capture","action":"subcult-demo capture","when":"subcult-demo status | grep -qx 'active=yes'"},
  "subcult.demo.exit": {"icon":"󰅖","label":"Exit and Reset Demo","action":"subcult-demo exit","when":"subcult-demo status | grep -qx 'active=yes'"},
  "subcult.operating-profile": {
    "icon": "󰍹",
    "label": "Operating Profile",
    "title": "SUBCULT // OPERATING PROFILE",
    "description": "Coordinate displays, power, bar density, audio, and wallpaper"
  },
  "subcult.operating-profile.auto": {
    "icon": "󰑐",
    "label": "Context-Managed (Auto)",
    "action": "subcult-operating-profile auto",
    "checked": "[[ $(subcult-operating-profile status | sed -n 's/^mode=//p') == auto ]]",
    "description": "Release the manual hold; changes still require automation opt-in"
  },
  "subcult.operating-profile.docked": {
    "icon": "󰍹",
    "label": "Force Docked",
    "action": "subcult-operating-profile docked",
    "checked": "[[ $(subcult-operating-profile status | sed -n 's/^mode=//p') == docked ]]"
  },
  "subcult.operating-profile.mobile": {
    "icon": "󰌢",
    "label": "Force Mobile",
    "action": "subcult-operating-profile mobile",
    "checked": "[[ $(subcult-operating-profile status | sed -n 's/^mode=//p') == mobile ]]"
  },
  "subcult.operating-profile.apply": {
    "icon": "󰑓",
    "label": "Reapply Current Profile",
    "action": "subcult-operating-profile apply"
  },
  "subcult.operating-profile.automation": {
    "icon": "󰒓",
    "label": "Context Automation",
    "title": "SUBCULT // PROFILE AUTOMATION",
    "description": "Preview or opt into bounded context-selected profiles"
  },
  "subcult.operating-profile.automation-enable": {
    "icon": "󰐕",
    "label": "Enable Environment Rule",
    "action": "subcult-context automation-rule environment_profile enable && subcult-context automation enable",
    "checked": "subcult-context status --json --compact | jq -e '.controller.automation_enabled and .controller.automation_rules.environment_profile' >/dev/null",
    "description": "Opt in to dock/mobile profile changes; manual selection still wins"
  },
  "subcult.operating-profile.automation-disable": {
    "icon": "󰅖",
    "label": "Disable All Automation",
    "action": "subcult-context automation disable",
    "description": "Global kill switch; recommendations remain visible"
  },
  "subcult.operating-profile.automation-preview": {
    "icon": "󰋼",
    "label": "Preview Pending Action",
    "action": "omarchy-launch-terminal subcult-context-automation preview",
    "description": "Read-only plan, holds, cooldown, and reason"
  },
  "subcult.operating-profile.automation-undo": {
    "icon": "󰕌",
    "label": "Undo Last Automated Change",
    "action": "subcult-context-automation undo",
    "description": "Restore the transaction snapshot captured before automation"
  },
  "subcult.ambient": {
    "icon": "󰖔",
    "label": "Ambient Operations",
    "title": "SUBCULT // AMBIENT OPERATIONS",
    "description": "Optional local time and explicit mission atmosphere"
  },
  "subcult.ambient.enable": {"icon":"󰐕","label":"Enable Ambient Cues","action":"subcult-ambient enable"},
  "subcult.ambient.disable": {"icon":"󰅖","label":"Disable Ambient Cues","action":"subcult-ambient disable"},
  "subcult.ambient.status": {"icon":"󰋼","label":"Show Ambient Status","action":"omarchy-launch-terminal subcult-ambient status"},
  "subcult.deployment": {
    "icon": "󰚩",
    "label": "SUBCULT Deployment",
    "title": "SUBCULT // DEVELOPMENT RUN",
    "description": "Assemble or recover the deterministic development mission"
  },
  "subcult.deployment.deploy": {
    "icon": "󰐊",
    "label": "Deploy Mission Workspace",
    "action": "subcult-deployment deploy",
    "checked": "[[ $(subcult-deployment status | head -n1) == active ]]"
  },
  "subcult.deployment.focus": {
    "icon": "󰍹",
    "label": "Focus Active Mission",
    "action": "subcult-deployment focus",
    "when": "[[ $(subcult-deployment status | head -n1) == active ]]"
  },
  "subcult.deployment.recover": {
    "icon": "󰜺",
    "label": "Recover Mission Workspace",
    "action": "subcult-deployment teardown",
    "when": "[[ $(subcult-deployment status | head -n1) == active ]]"
  },
  "subcult.intrusion": {
    "icon": "󰀦",
    "label": "Intrusion Drill",
    "title": "SUBCULT // SECURITY CONDITION ONE",
    "description": "Manual red-alert demonstration with transactional recovery"
  },
  "subcult.intrusion.enter": {
    "icon": "󰐊",
    "label": "Initiate Simulation",
    "action": "subcult-intrusion enter",
    "when": "[[ $(subcult-intrusion status) == inactive ]]"
  },
  "subcult.intrusion.exit": {
    "icon": "󰅖",
    "label": "SAFE EXIT / Restore State",
    "action": "subcult-intrusion exit",
    "when": "[[ $(subcult-intrusion status) != inactive ]]"
  },
  "subcult.intrusion.preview": {
    "icon": "󰍹",
    "label": "Preview Warning Display",
    "action": "subcult-intrusion preview",
    "description": "Preview the OSD without changing desktop state"
  },
  "subcult.workspace-osd": {
    "icon": "󰍹",
    "label": "Workspace Channel OSD",
    "action": "subcult-workspace-osd toggle",
    "checked": "[[ $(subcult-workspace-osd status) == enabled ]]",
    "description": "Toggle brief SUBCULT channel overlays during workspace changes"
  },
  "subcult.focus": {
    "icon": "󰭟",
    "label": "Closed Door Focus Mode",
    "action": "subcult-focus toggle",
    "checked": "[[ $(subcult-focus status) == active ]]",
    "description": "Suppress non-critical communications and apply focus treatment"
  },
  "subcult.mission": {
    "icon": "󰔛",
    "label": "Mission Timer",
    "title": "SUBCULT // MISSION CLOCK",
    "description": "Persistent focus runs and recovery cycles"
  },
  "subcult.mission.panel": {"icon":"󰋼","label":"Open Mission Clock","action":"omarchy-shell subcult-mission toggle"},
  "subcult.mission.start": {"icon":"󰐊","label":"Begin Mission","action":"subcult-mission start"},
  "subcult.mission.toggle": {"icon":"󰏤","label":"Pause / Resume","action":"subcult-mission toggle"},
  "subcult.mission.advance": {"icon":"󰒭","label":"Advance Phase","action":"subcult-mission skip"},
  "subcult.mission.abort": {"icon":"󰅖","label":"Abort Mission","action":"subcult-mission abort"},
  "subcult.health": {"icon":"󰄬","label":"System Health","title":"SUBCULT // SYSTEM HEALTH","description":"Battery, thermal, storage, memory, services, updates, and connectivity"},
  "subcult.health.panel": {"icon":"󰋼","label":"Open Health Panel","action":"omarchy-shell subcult-health toggle"},
  "subcult.health.inspect": {"icon":"󰆍","label":"Terminal Health Report","action":"omarchy-launch-terminal -- bash -lc 'subcult-health status; echo; read -rp \"Press Enter to close...\"'"},
  "subcult.health.preview": {"icon":"󰀦","label":"Preview Health Warning","action":"subcult-health preview --seconds 30"},
  "subcult.context": {"icon":"󰘦","label":"Context Inspector","title":"SUBCULT // CONTEXT INSPECTOR","description":"Explain current local context, freshness, contributing facts, and recommendations"},
  "subcult.context.panel": {"icon":"󰋼","label":"Open Context Inspector","action":"omarchy-shell subcult-context-inspector toggle"},
  "subcult.context.refresh": {"icon":"󰑐","label":"Refresh Context","action":"omarchy-shell subcult-context-inspector refresh","description":"Collect a new bounded local observation and update the inspector"},
  "subcult.context.explain": {"icon":"󰆍","label":"Terminal Explanation","action":"omarchy-launch-terminal -- bash -lc 'subcult-context explain; echo; read -rp \"Press Enter to close...\"'"},
  "subcult.clock": {"icon":"󰥔","label":"World & Mission Clock","title":"SUBCULT // WORLD CHRONOMETER","description":"Arizona, UTC, remote zones, uptime, and mission elapsed time"},
  "subcult.clock.panel": {"icon":"󰋼","label":"Open Clock Matrix","action":"omarchy-shell subcult-clock toggle"},
  "subcult.clock.toggle": {"icon":"󰐊","label":"Start / Pause Mission Elapsed","action":"subcult-clock toggle"},
  "subcult.clock.reset": {"icon":"󰑐","label":"Reset Mission Elapsed","action":"subcult-clock reset"},
  "subcult.capture": {"icon":"󰹑","label":"Capture Operations","title":"SUBCULT // CAPTURE CONTROL","description":"Screenshots and persistent recording telemetry"},
  "subcult.capture.screenshot": {"icon":"󰹑","label":"Interactive Screenshot","action":"subcult-capture screenshot"},
  "subcult.capture.recording": {"icon":"󰑋","label":"Start / Stop Recording","action":"subcult-capture recording --stop-recording || omarchy-menu toggle trigger.capture.screenrecord"},
  "subcult.communications": {
    "icon": "󰖩",
    "label": "Communication Link",
    "action": "omarchy-shell subcult-communications toggle",
    "description": "Network, Bluetooth, VPN, route, and Tailscale telemetry"
  },
  "subcult.privacy": {
    "icon": "󰒃",
    "label": "Privacy Activity",
    "title": "SUBCULT // PRIVACY CONTROL",
    "description": "Inspect microphone, camera, sharing, recording, and remote-control activity"
  },
  "subcult.privacy.inspect": {
    "icon": "󰋼",
    "label": "Open Activity Monitor",
    "action": "omarchy-shell subcult-privacy toggle"
  },
  "subcult.privacy.respond": {
    "icon": "󰒃",
    "label": "Safe Privacy Response",
    "action": "subcult-privacy stop all",
    "description": "Mute the microphone and stop known recorders or remote-control services"
  },
  "subcult.privacy.preview": {
    "icon": "󰔡",
    "label": "Preview All Alerts",
    "action": "subcult-privacy preview microphone,camera,screen,recording,remote --seconds 30"
  },
  "subcult.media": {
    "icon": "󰝚",
    "label": "Audio Channel",
    "title": "SUBCULT // MEDIA CONTROL",
    "description": "Control the active MPRIS playback source"
  },
  "subcult.media.previous": {
    "icon": "󰒮",
    "label": "Previous Track",
    "action": "subcult-media previous"
  },
  "subcult.media.play-pause": {
    "icon": "󰐎",
    "label": "Play / Pause",
    "action": "subcult-media play-pause"
  },
  "subcult.media.next": {
    "icon": "󰒭",
    "label": "Next Track",
    "action": "subcult-media next"
  },
  "subcult.media.stop": {
    "icon": "󰓛",
    "label": "Stop Playback",
    "action": "subcult-media stop"
  },
  "subcult.boot": {
    "icon": "󰚩",
    "label": "Startup Sequence",
    "title": "SUBCULT // LOGIN SEQUENCE",
    "description": "Preview or configure graphical-login telemetry"
  },
  "subcult.boot.preview": {
    "icon": "󰐊",
    "label": "Preview Sequence",
    "action": "setsid -f subcult-boot-sequence preview",
    "description": "Run the sequence without changing its setting"
  },
  "subcult.boot.enable": {
    "icon": "󰄬",
    "label": "Enable at Login",
    "action": "subcult-boot-sequence enable",
    "checked": "[[ $(subcult-boot-sequence status) == enabled ]]"
  },
  "subcult.boot.disable": {
    "icon": "󰅖",
    "label": "Disable at Login",
    "action": "subcult-boot-sequence disable",
    "checked": "[[ $(subcult-boot-sequence status) == disabled ]]"
  },
  "subcult.sounds": {
    "icon": "󰕾",
    "label": "Interface Sound Cues",
    "title": "SUBCULT // AUDIO FEEDBACK",
    "description": "Preview or configure procedural UI sounds"
  },
  "subcult.sounds.test": {
    "icon": "󰐊",
    "label": "Test Sound Sequence",
    "action": "setsid -f subcult-sound preview all"
  },
  "subcult.sounds.enable": {
    "icon": "󰄬",
    "label": "Enable Sound Cues",
    "action": "subcult-sound enable",
    "checked": "[[ $(subcult-sound status) == enabled ]]"
  },
  "subcult.sounds.disable": {
    "icon": "󰝟",
    "label": "Disable Sound Cues",
    "action": "subcult-sound disable",
    "checked": "[[ $(subcult-sound status) == disabled ]]"
  },
  "subcult.sounds.kill": {
    "icon": "󰓛",
    "label": "Kill All Sound Immediately",
    "action": "subcult-sound kill",
    "description": "Persistently closes global audio authority"
  },
  "subcult.sounds.session": {
    "icon": "󰍃",
    "label": "Toggle Session Cues",
    "action": "[[ $(subcult-sound status --json | jq -r '.categories.session.enabled') == true ]] && subcult-sound category session disable || subcult-sound category session enable",
    "checked": "[[ $(subcult-sound status --json | jq -r '.categories.session.enabled') == true ]]"
  },
  "subcult.sounds.system": {
    "icon": "󰓅",
    "label": "Toggle System Cues",
    "action": "[[ $(subcult-sound status --json | jq -r '.categories.system.enabled') == true ]] && subcult-sound category system disable || subcult-sound category system enable",
    "checked": "[[ $(subcult-sound status --json | jq -r '.categories.system.enabled') == true ]]"
  },
  "subcult.sounds.workflow": {
    "icon": "󰄬",
    "label": "Toggle Workflow Cues",
    "action": "[[ $(subcult-sound status --json | jq -r '.categories.workflow.enabled') == true ]] && subcult-sound category workflow disable || subcult-sound category workflow enable",
    "checked": "[[ $(subcult-sound status --json | jq -r '.categories.workflow.enabled') == true ]]"
  },
  "subcult.sounds.critical": {
    "icon": "󰀪",
    "label": "Toggle Critical Cues",
    "action": "[[ $(subcult-sound status --json | jq -r '.categories.critical.enabled') == true ]] && subcult-sound category critical disable || subcult-sound category critical enable",
    "checked": "[[ $(subcult-sound status --json | jq -r '.categories.critical.enabled') == true ]]"
  },
  "subcult.sounds.quiet": {
    "icon": "󰒲",
    "label": "Quiet Hours 22:00–07:00",
    "action": "[[ $(subcult-sound status --json | jq -r '.quiet_hours.enabled') == true ]] && subcult-sound quiet-hours off || subcult-sound quiet-hours 22 7",
    "checked": "[[ $(subcult-sound status --json | jq -r '.quiet_hours.enabled') == true ]]"
  },
  "subcult.power-sequence": {
    "icon": "󰚥",
    "label": "Mains Power Sequence",
    "title": "SUBCULT // POWER TRANSITION",
    "description": "Preview AC and internal-power telemetry"
  },
  "subcult.power-sequence.ac": {
    "icon": "󰚥",
    "label": "Preview Mains Power",
    "action": "subcult-power-sequence preview ac"
  },
  "subcult.power-sequence.battery": {
    "icon": "󰁹",
    "label": "Preview Internal Power",
    "action": "subcult-power-sequence preview battery"
  },
  "subcult.devices": {
    "icon": "󰋐",
    "label": "External Device Telemetry",
    "title": "SUBCULT // EXTERNAL INTERFACE",
    "description": "Preview device notices or open recent mounted storage"
  },
  "subcult.devices.preview-storage": {
    "icon": "󰋊",
    "label": "Preview Storage Connection",
    "action": "subcult-device-osd preview storage connected"
  },
  "subcult.devices.preview-display": {
    "icon": "󰍹",
    "label": "Preview Display Link",
    "action": "subcult-device-osd preview display connected"
  },
  "subcult.devices.open-storage": {
    "icon": "󰉋",
    "label": "Open Recent Mounted Storage",
    "action": "subcult-device-osd open",
    "when": "[[ -r $HOME/.local/state/subcult-rice/device-osd/last-storage ]]"
  },
  "subcult.command-telemetry": {
    "icon": "󰆍",
    "label": "Command Completion Telemetry",
    "title": "SUBCULT // TERMINAL OPERATIONS",
    "description": "Long-running command completion notices without command text"
  },
  "subcult.command-telemetry.preview-success": {
    "icon": "󰄬",
    "label": "Preview Successful Operation",
    "action": "subcult-command-telemetry preview-success"
  },
  "subcult.command-telemetry.preview-failure": {
    "icon": "󰅖",
    "label": "Preview Failed Operation",
    "action": "subcult-command-telemetry preview-failure"
  },
  "subcult.command-telemetry.enable": {
    "icon": "󰄬",
    "label": "Enable Command Telemetry",
    "action": "subcult-command-telemetry enable",
    "checked": "[[ $(subcult-command-telemetry status | sed -n 's/^enabled=//p') == yes ]]"
  },
  "subcult.command-telemetry.disable": {
    "icon": "󰅖",
    "label": "Disable Command Telemetry",
    "action": "subcult-command-telemetry disable"
  },
  "subcult.thermal": {
    "icon": "󰔏",
    "label": "Thermal Monitoring",
    "title": "SUBCULT // THERMAL CONTROL",
    "description": "Inspect or preview temperature alerts"
  },
  "subcult.thermal.status": {
    "icon": "󰔏",
    "label": "Show Thermal Status",
    "action": "omarchy-launch-terminal -- bash -lc 'subcult-thermal-alert status | jq; read -rp \"Press Enter to close...\"'"
  },
  "subcult.thermal.preview-warning": {
    "icon": "󰀪",
    "label": "Preview Elevated Warning",
    "action": "subcult-thermal-alert preview warning"
  },
  "subcult.thermal.preview-critical": {
    "icon": "󰀦",
    "label": "Preview Critical Warning",
    "action": "subcult-thermal-alert preview critical"
  },
  "subcult.thermal.enable": {
    "label": "Enable Thermal Alerts",
    "action": "subcult-thermal-alert enable",
    "checked": "[[ $(subcult-thermal-alert status | jq -r .enabled) == true ]]"
  },
  "subcult.thermal.disable": {
    "label": "Disable Thermal Alerts",
    "action": "subcult-thermal-alert disable"
  },
  "subcult.update-operation": {"icon":"󰚰","label":"SUBCULT System Update","title":"SUBCULT // MAINTENANCE OPERATION","description":"Run Omarchy update with phase telemetry and durable logs"},
  "subcult.update-operation.run": {"icon":"󰐊","label":"Launch Interactive Update","action":"omarchy-launch-terminal -- bash -lc 'subcult-update run; code=$?; echo; read -rp \"Update exited $code. Press Enter to close...\"; exit $code'"},
  "subcult.update-operation.status": {"icon":"󰋼","label":"Show Last Update Status","action":"omarchy-launch-terminal -- bash -lc 'subcult-update status; read -rp \"Press Enter to close...\"'"},
  "subcult.update-operation.log": {"icon":"󰈙","label":"Open Last Full Log","action":"omarchy-launch-terminal -- subcult-update log"},
  "subcult.suite-update": {"icon":"󰚰","label":"SUBCULT Suite Updates","title":"SUBCULT // RICE RELEASE CONTROL","description":"Stable, Preview, and Development rice updates with evidence, exact preview, validation, and undo"},
  "subcult.suite-update.guide": {"icon":"󰐊","label":"Guided Update","action":"omarchy-launch-terminal -- bash -lc 'subcult-suite-update guide; code=$?; echo; read -rp \"Update exited $code. Press Enter to close...\"; exit $code'"},
  "subcult.suite-update.check": {"icon":"󰋼","label":"Check Selected Channel","action":"omarchy-launch-terminal -- bash -lc 'subcult-suite-update check; echo; read -rp \"Press Enter to close...\"'"},
  "subcult.suite-update.channel": {"icon":"󰘬","label":"Show Selected Channel","action":"omarchy-launch-terminal -- bash -lc 'subcult-suite-update channel; echo; echo \"Change with: subcult-suite-update channel stable|preview|development\"; read -rp \"Press Enter to close...\"'"},
  "subcult.suite-update.undo": {"icon":"󰕌","label":"Undo Last Suite Update","action":"omarchy-launch-terminal -- bash -lc 'read -rp \"Type UNDO to restore the last suite snapshot: \" answer; [[ $answer == UNDO ]] || { echo \"Undo cancelled.\"; read -rp \"Press Enter to close...\"; exit 0; }; subcult-suite-update undo --yes; code=$?; echo; read -rp \"Undo exited $code. Press Enter to close...\"; exit $code'"},
  "subcult.onboarding": {"icon":"󰋗","label":"First-Run & Transfer","title":"SUBCULT // ONBOARDING","description":"Guided setup and privacy-sanitized configuration transfer"},
  "subcult.onboarding.guide": {"icon":"󰐊","label":"Open Guided Setup","action":"omarchy-launch-terminal -- subcult-onboard guide"},
  "subcult.onboarding.status": {"icon":"󰋼","label":"Onboarding Status","action":"omarchy-launch-terminal -- bash -lc 'subcult-onboard status; read -rp \"Press Enter to close...\"'"},
  "subcult.start-page": {"icon":"󰖟","label":"SUBCULT Browser Start Page","action":"subcult-start-page open","description":"Open the local dashboard in the current default browser"},
  "subcult.download-intake": {"icon":"󰇚","label":"Classified Download Intake","title":"SUBCULT // DOWNLOAD INTAKE","description":"Inspect recent downloads before opening, revealing, hashing, or archiving them"},
  "subcult.download-intake.open": {"icon":"󰈙","label":"Open Intake Console","action":"omarchy-launch-terminal -- subcult-downloads open"},
  "subcult.download-intake.folder": {"icon":"󰉋","label":"Open Downloads Directory","action":"xdg-open \"$(subcult-downloads directory)\""},
  "subcult.download-intake.list": {"icon":"󰋼","label":"Print Recent Intake","action":"omarchy-launch-terminal -- bash -lc 'subcult-downloads list; echo; read -rp \"Press Enter to close...\"'"},
  "subcult.controls": {
    "icon": "󰌌",
    "label": "Control Reference",
    "action": "subcult-control-reference",
    "description": "Open SUBCULT shortcuts and command guide"
  },
  "subcult.theme": {
    "icon": "󰏘",
    "label": "Theme Systems",
    "action": "theme=$(omarchy-theme-switcher); [[ -n $theme ]] && omarchy-theme-set \"$theme\"",
    "description": "Select and manage desktop themes"
  },
  "subcult.terminal": {
    "icon": "󰆍",
    "label": "Terminal Profile",
    "title": "SUBCULT // TERMINAL COLOR SYSTEM",
    "description": "Switch coordinated terminal color profiles"
  },
  "subcult.terminal.violet": {
    "icon": "󰘧",
    "label": "Violet Field",
    "action": "subcult-terminal-profile violet",
    "checked": "[[ $(subcult-terminal-profile status) == violet ]]",
    "description": "Primary desktop profile"
  },
  "subcult.terminal.subcult": {
    "icon": "󰔟",
    "label": "SUBCULT Press",
    "action": "subcult-terminal-profile subcult",
    "checked": "[[ $(subcult-terminal-profile status) == subcult ]]",
    "description": "System diagnostics profile"
  },
  "subcult.terminal.engineering": {
    "icon": "󰈸",
    "label": "Engineering Orange",
    "action": "subcult-terminal-profile engineering",
    "checked": "[[ $(subcult-terminal-profile status) == engineering ]]",
    "description": "Maintenance and operations profile"
  },
  "subcult.terminal.context": {"icon":"󰉋","label":"Context-Aware Terminal","title":"SUBCULT // TERMINAL CONTEXT","description":"Choose an isolated profile from the launch directory without recoloring existing terminals"},
  "subcult.terminal.context.launch": {"icon":"󰆍","label":"Launch Context Terminal Here","action":"subcult-terminal-context launch"},
  "subcult.terminal.context.inspect": {"icon":"󰋼","label":"Inspect Current Directory Rule","action":"omarchy-launch-terminal -- bash -lc 'subcult-terminal-context detect --json | jq; echo; read -rp \"Press Enter to close...\"'"},
  "subcult.terminal.context.rules": {"icon":"󰒓","label":"Edit Context Rules","action":"omarchy-launch-editor ~/.config/omarchy/subcult-terminal-context.json"},
  "subcult.lock": {
    "icon": "󰌾",
    "label": "Secure Terminal",
    "action": "omarchy system lock",
    "description": "Lock this workstation"
  },
  "subcult.system": {
    "icon": "󰐥",
    "label": "System and Power",
    "target": "system",
    "description": "Suspend, restart, shut down, or log out"
  },

  // SUBCULT session control. Destructive actions drill into a confirmation
  // submenu whose first selection is always ABORT; execution requires an
  // additional directional choice and activation.
  "system": {
    "icon": "󰐥",
    "label": "SUBCULT Session Control",
    "title": "SUBCULT // SESSION",
    "description": "Secure workstation state and power operations"
  },
  "system.screensaver": {
    "label": "Idle Display",
    "action": "bash -lc 'omarchy-launch-screensaver force'",
    "description": "Activate the configured visual standby sequence"
  },
  "system.lock": {
    "label": "Authorization Lock",
    "action": "omarchy-system-lock",
    "description": "Secure the workstation immediately"
  },
  "system.suspend": {
    "label": "Standby",
    "when": "! omarchy-toggle-enabled suspend-off",
    "action": "systemctl suspend",
    "description": "Suspend system operation"
  },
  "system.hibernate": {
    "label": "Deep Standby",
    "when": "omarchy-hibernation-available",
    "action": "systemctl hibernate",
    "description": "Hibernate system state to disk"
  },
  "system.logout": {
    "label": "Terminate Session",
    "title": "LOGOUT?",
    "description": "Close applications and end the graphical session",
    "action": ""
  },
  "system.reboot": {
    "label": "Restart Systems",
    "title": "RESTART?",
    "description": "Close applications and reboot the workstation",
    "action": ""
  },
  "system.shutdown": {
    "label": "System Shutdown",
    "title": "SHUTDOWN?",
    "description": "Close applications and power off the workstation",
    "action": ""
  },
  "system.cancel": {
    "icon": "󰜺",
    "label": "ABORT // DESKTOP",
    "action": "true",
    "description": "Abort session control without changing system state"
  },
  "system.logout.abort": {
    "icon": "󰜺",
    "label": "ABORT // KEEP SESSION",
    "action": "true",
    "description": "Return to the desktop"
  },
  "system.logout.execute": {
    "icon": "󰍃",
    "label": "EXECUTE // LOGOUT",
    "action": "omarchy-system-logout",
    "description": "Close applications and terminate this session"
  },
  "system.reboot.abort": {
    "icon": "󰜺",
    "label": "ABORT // STAY ONLINE",
    "action": "true",
    "description": "Return to the desktop"
  },
  "system.reboot.execute": {
    "icon": "󰜉",
    "label": "EXECUTE // RESTART",
    "action": "omarchy-system-reboot",
    "description": "Close applications and restart the workstation"
  },
  "system.shutdown.abort": {
    "icon": "󰜺",
    "label": "ABORT // STAY ONLINE",
    "action": "true",
    "description": "Return to the desktop"
  },
  "system.shutdown.execute": {
    "icon": "󰐥",
    "label": "EXECUTE // SHUTDOWN",
    "action": "omarchy-system-shutdown",
    "description": "Close applications and power off the workstation"
  },

  // Preserve the installed Neon Overdrive controls for that theme.
  "style.neon-overdrive": {
    "icon": "󰢮",
    "label": "Neon Overdrive",
    "title": "Neon Overdrive Controls",
    "when": "subcult-capabilities has neon-overdrive"
  },
  "style.neon-overdrive.preset": {"icon":"󰏘","label":"Preset"},
  "style.neon-overdrive.preset.static": {"icon":"󰖔","label":"Static","checked":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control is-preset static","action":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control preset static"},
  "style.neon-overdrive.preset.balanced": {"icon":"󰾅","label":"Balanced","checked":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control is-preset balanced","action":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control preset balanced"},
  "style.neon-overdrive.preset.overdrive": {"icon":"󱐋","label":"Overdrive","checked":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control is-preset overdrive","action":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control preset overdrive"},
  "style.neon-overdrive.rain": {"icon":"󰖗","label":"Rain","checked":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control enabled rain","action":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control toggle rain"},
  "style.neon-overdrive.audio": {"icon":"󰝚","label":"Audio Reactivity","checked":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control enabled audio_reactivity","action":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control toggle audio_reactivity"},
  "style.neon-overdrive.cava": {"icon":"󰺢","label":"CAVA Visualizer","checked":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control enabled cava","action":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control toggle cava"},
  "style.neon-overdrive.bloom": {"icon":"󰛨","label":"Magenta Bloom","checked":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control enabled bloom","action":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control toggle bloom"},
  "style.neon-overdrive.edge": {"icon":"󰇀","label":"Screen-edge Glow","checked":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control enabled edge_glow","action":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control toggle edge_glow"},
  "style.neon-overdrive.drift": {"icon":"󰒟","label":"Camera Drift","checked":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control enabled camera_drift","action":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control toggle camera_drift"},
  "style.neon-overdrive.window-glow": {"icon":"󰖯","label":"Window Glow","checked":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control enabled window_glow","action":"~/.config/omarchy/themes/neon-overdrive/scripts/neon-control toggle window_glow"}
}
