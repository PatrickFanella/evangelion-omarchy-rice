# Omarchy environment (OMARCHY_PATH + PATH), needed even for non-interactive shells
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap

# User-owned Omarchy command overrides (including the SUBCULT screensaver)
# must resolve before the packaged /usr/bin commands in login and idle shells.
export PATH="$HOME/.local/bin:$PATH"

# If not running interactively, don't do anything else (leave this above the rc source)
[[ $- != *i* ]] && return

# All the default Omarchy aliases and functions
# (don't mess with these directly, just overwrite them here!)
source "$OMARCHY_PATH/default/bash/rc"

# SUBCULT terminal and TUI profile integration. This file is generated by
# subcult-terminal-profile and keeps all tool-specific overrides reversible.
subcult_tools_env="${XDG_STATE_HOME:-$HOME/.local/state}/subcult-rice/tools/tools.env"
[[ -r $subcult_tools_env ]] && source "$subcult_tools_env"
unset subcult_tools_env

# Notify on long-running interactive commands without retaining command text.
[[ -r $HOME/.config/omarchy/subcult-command-telemetry.bash ]] && source "$HOME/.config/omarchy/subcult-command-telemetry.bash"

